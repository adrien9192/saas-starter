# Copy to .env.local and fill in. `.env.local` is gitignored.
#
# Only VITE_* variables reach the browser — treat every one of them as public.
# Backend secrets (Resend, Stripe, AI providers) are NOT set here: they live in
# the Convex deployment environment, because that is where the code that uses
# them runs.  Set those with:  pnpm convex env set NAME=value

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:3000

# ── Convex ────────────────────────────────────────────────────────────────────
# Written automatically by `pnpm convex` on first run.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# ── Clerk ─────────────────────────────────────────────────────────────────────
# dashboard.clerk.com → API keys
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Also required, on the Convex deployment (not here):
#   pnpm convex env set CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev

# ── PostHog (optional) ────────────────────────────────────────────────────────
# Unset = analytics disabled, every track() call is a no-op.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Unset = Sentry disabled, the app runs normally.
VITE_SENTRY_DSN=
# Build-time only, for uploading source maps in CI:
SENTRY_AUTH_TOKEN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=

# ── End-to-end tests (optional) ───────────────────────────────────────────────
# Without these, `pnpm test:e2e` runs the smoke specs only.
E2E_BASE_URL=http://localhost:3000
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════════
# Convex deployment environment — set with `pnpm convex env set NAME=value`.
# Listed here for discoverability only; do not put values in this file.
#
#   CLERK_JWT_ISSUER_DOMAIN   required   Clerk issuer URL
#   APP_URL                   optional   absolute URL used in emails
#   RESEND_API_KEY            optional   unset = emails are logged, not sent
#   EMAIL_FROM                optional   e.g. "Acme <hello@acme.com>"
#   ANTHROPIC_API_KEY         optional   only if an AI feature uses it
#   OPENAI_API_KEY            optional
#   GOOGLE_GENERATIVE_AI_API_KEY optional
#   OPENROUTER_API_KEY        optional
#   STRIPE_SECRET_KEY         optional   only once billing is switched on
#   STRIPE_WEBHOOK_SECRET     optional
# ══════════════════════════════════════════════════════════════════════════════
