{
  "name": "saas-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "imports": {
    "#/*": "./src/*"
  },
  "intent": {
    "skills": [
      "@tanstack/cli",
      "@tanstack/react-start",
      "@tanstack/react-table",
      "@tanstack/router-core",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/table-core",
      "@tanstack/router-plugin",
      "@tanstack/virtual-file-routes"
    ]
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port ${PORT:-3000}\"",
    "convex": "convex dev",
    "bootstrap": "dotenv -e .env.local -- node scripts/setup.mjs",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit && tsc -p convex --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "email": "email dev --dir emails --port 3001"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.36",
    "@clerk/tanstack-react-start": "^1.4.29",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@sentry/tanstackstart-react": "^10.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-form": "^1.33.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.42",
    "@tanstack/react-table": "^9.1.2",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "posthog-js": "^1.415.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "resend": "^6.18.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@clerk/testing": "^2.2.19",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/cli": "^0.70.2",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/intent": "^0.3.6",
    "@tanstack/router-cli": "^1.167.27",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.55",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@sentry/cli"
    ]
  }
}
